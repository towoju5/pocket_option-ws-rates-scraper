# Runs the live-prices web app forever on the VPS: starts on boot, and restarts
# automatically if it ever crashes or the process is killed.
#
# Install (on the VPS, as a user with sudo):
#   1. sudo cp deploy/pocket-option-webapp.service.example /etc/systemd/system/pocket-option-webapp.service
#   2. Edit the copy: replace <deploy-user> and /path/to/pocket_option-0.4.0 below with
#      the real values (whoever this runs as, and where you cloned/copied the repo).
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now pocket-option-webapp
#
# Check on it:
#   sudo systemctl status pocket-option-webapp
#   sudo journalctl -u pocket-option-webapp -f

[Unit]
Description=PocketOption live prices web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<deploy-user>
WorkingDirectory=/path/to/pocket_option-0.4.0
EnvironmentFile=/path/to/pocket_option-0.4.0/.env
ExecStart=/bin/bash /path/to/pocket_option-0.4.0/start_webapp_hosted.sh
Restart=always
RestartSec=5

# Hard resource ceiling, kernel-enforced (cgroups) - not something the app's own code
# can exceed even if a future bug leaks memory or spins the CPU. Sized for a 1GB RAM /
# 2 vCPU VPS shared with other projects; measured steady-state here is ~100MB RSS and
# well under 1 core, so this leaves generous headroom for this app while guaranteeing
# the other projects on the box always keep at least 1 full core and ~600MB free no
# matter what this one does.
#   MemoryHigh: soft ceiling - the kernel throttles/reclaims before this, rather than
#     killing outright, so a brief spike degrades gracefully instead of restarting.
#   MemoryMax: hard ceiling - OOM-killed if exceeded; Restart=always above brings it
#     back up clean rather than leaving it dead or letting it eat past this point.
#   CPUQuota=100%: caps this service to the equivalent of 1 full core, so the second
#     core is always available to your other projects regardless of load here.
#   TasksMax: caps total threads/processes this service can spawn, as a backstop
#     against a runaway fork/thread bomb from ever exhausting system-wide PIDs.
MemoryHigh=300M
MemoryMax=400M
CPUQuota=100%
TasksMax=256

[Install]
WantedBy=multi-user.target
