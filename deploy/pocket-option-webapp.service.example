# Runs the live-prices web app forever on the VPS: starts on boot, and restarts
# automatically if it ever crashes or the process is killed.
#
# Install (on the VPS, as a user with sudo):
#   1. sudo cp deploy/pocket-option-webapp.service.example /etc/systemd/system/pocket-option-webapp.service
#   2. Edit the copy: replace <deploy-user> and /path/to/pocket_option-ws-rates-scraper below with
#      the real values (whoever this runs as, and where you cloned/copied the repo).
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now pocket-option-webapp
#
# Check on it:
#   sudo systemctl status pocket-option-webapp
#   sudo journalctl -u pocket-option-webapp -f

[Unit]
Description=PocketOption live prices web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<deploy-user>
WorkingDirectory=/path/to/pocket_option-ws-rates-scraper
EnvironmentFile=/path/to/pocket_option-ws-rates-scraper/.env
ExecStart=/bin/bash /path/to/pocket_option-ws-rates-scraper/start_webapp_hosted.sh
Restart=always
RestartSec=5

# Hard resource ceiling, kernel-enforced (cgroups) - not something the app's own code
# can exceed even if a future bug leaks memory or spins the CPU. Sized for a 24GB RAM /
# 4 vCPU box shared with other (production) projects; measured steady-state here is
# ~110MB RSS and well under 1 core, so these caps are generous headroom (~14x actual
# usage for memory) rather than a tight squeeze - the point is a real ceiling that
# guarantees this app can never eat into what the rest of the box needs, not
# minimizing its footprint on a box that has plenty of room.
#   MemoryHigh: soft ceiling - the kernel throttles/reclaims before this, rather than
#     killing outright, so a brief spike degrades gracefully instead of restarting.
#   MemoryMax: hard ceiling - OOM-killed if exceeded; Restart=always above brings it
#     back up clean rather than leaving it dead or letting it eat past this point.
#   CPUQuota=100%: caps this service to the equivalent of 1 full core - this app is
#     single-threaded (Python's GIL), so it physically can't use more than that anyway;
#     on a 4-core box this guarantees the other 3 are always available regardless of
#     load here.
#   TasksMax: caps total threads/processes this service can spawn, as a backstop
#     against a runaway fork/thread bomb from ever exhausting system-wide PIDs.
MemoryHigh=1G
MemoryMax=1536M
CPUQuota=100%
TasksMax=256

[Install]
WantedBy=multi-user.target
