# Copy this file to .env and fill in your session values.
# See README.md "Getting Session ID and UID" for how to obtain these.
PO_SESSION=so00kntfpsc4ofua4kbcc5ljpp
PO_UID=90386873

# Optional, used by start_webapp.sh / examples/webapp.py:
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8081
WEBAPP_AUTO_OPEN=1   # set to 0 to skip auto-opening a browser tab
WEBAPP_ALLOWED_CLIENTS=
#   Comma-separated, permanent client allowlist (IPv4, IPv6, "localhost", or a URL/hostname
#   resolved via DNS at startup). Unset = open access. See WEBAPP.md for details.
#   Left blank so the site is reachable from anywhere — the previous value here was
#   .env.example's placeholder addresses, which would have 403'd every real visitor.
WEBAPP_ADMIN_PASSWORD=
#   Enables the /admin panel for adding/removing temporary (or permanent) whitelist
#   entries at runtime, with expiry. Unset = admin panel disabled.
WEBAPP_ADMIN_SESSION_HOURS=12
WEBAPP_ALWAYS_ON_ASSETS=all
#   Keeps every currently-active asset streaming/buffered at all times, so anyone who
#   subscribes over /ws gets an already-warm feed instead of waiting on a fresh upstream
#   subscribe. See .env.example for the comma-separated-list alternative.
WEBAPP_TRUST_PROXY=1
#   The VPS's existing nginx/Caddy in front of this app terminates TLS for datafeedcl.xyz
#   and forwards plain HTTP here — set this so the allowlist and secure-cookie detection
#   see the real client IP from X-Forwarded-For instead of the proxy's own IP. Only keep
#   this "1" as long as that proxy is genuinely the sole way to reach the app (port 8081
#   itself must not be directly reachable from the internet, or this becomes spoofable).
