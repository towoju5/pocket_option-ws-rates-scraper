# Copy this file to .env and fill in your session values.
# See README.md "Getting Session ID and UID" for how to obtain these.
PO_SESSION=
PO_UID=

# Optional, used by start_webapp.sh / examples/webapp.py:
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8081
WEBAPP_AUTO_OPEN=1   # set to 0 to skip auto-opening a browser tab
WEBAPP_ALLOWED_CLIENTS=localhost,203.0.113.5,2001:db8::1,bot.example.com
#   Comma-separated, permanent client allowlist (IPv4, IPv6, "localhost", or a URL/hostname
#   resolved via DNS at startup). Unset = open access. See WEBAPP.md for details.
WEBAPP_ADMIN_PASSWORD=
#   Enables the /admin panel for adding/removing temporary (or permanent) whitelist
#   entries at runtime, with expiry. Unset = admin panel disabled.
WEBAPP_ADMIN_SESSION_HOURS=12
WEBAPP_ALWAYS_ON_ASSETS=
#   Comma-separated asset symbols (see GET /api/assets), or "all", to keep streaming and
#   buffering at all times, even with no browser/WS client connected — so a client that
#   subscribes gets an already-warm feed instead of waiting on a fresh upstream subscribe.
#   Unset = only streams assets someone is actively watching (stops once they all leave).
WEBAPP_CANDLE_STORAGE=
REDIS_URL=
#   WEBAPP_CANDLE_STORAGE="redis" persists tick history in Redis so it survives
#   restarts — needs the 'redis' extra installed (`pip install pocket-option[redis]`).
#   REDIS_URL defaults to redis://localhost:6379/0 if unset; if you're running the
#   dedicated instance from deploy/install-redis.sh (recommended when Redis is already
#   used by other projects on the box), set REDIS_URL=redis://localhost:6380/0 instead
#   so this app's data stays on its own instance. Unset/"memory" = original
#   in-process-only behavior, no external dependency, but history is lost on restart.

# Hosted-deployment only — usually set via start_webapp_hosted.sh instead of here.
# See WEBAPP.md "Deploying to a hosted platform" before using either.
WEBAPP_SSL_CERT=
WEBAPP_SSL_KEY=
#   Cert/key PEM paths. Set both to have this process terminate TLS itself (wss:// with
#   no reverse proxy). Leave blank if a reverse proxy in front handles TLS instead.
WEBAPP_TRUST_PROXY=0
#   Set to 1 ONLY when behind a reverse proxy that sets X-Forwarded-For/-Proto. Never
#   enable this if the app is also directly reachable — it lets clients spoof their IP.
